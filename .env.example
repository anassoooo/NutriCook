# ─────────────────────────────────────────────────────────────────────────────
# NutriCook environment template
#   cp .env.example .env      then fill in the values marked REQUIRED.
# .env is gitignored. Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Spring profile: docker (inside Compose), prod (deployment), local (backend on host, DB on :5433)
SPRING_PROFILES_ACTIVE=docker

# ── AI (Groq, free tier) ─────────────────────────────────────────────────────
# REQUIRED for AI features. Get a free key at https://console.groq.com
# The app still starts without it; AI text is simply unavailable.
GROQ_API_KEY=replace-me
GROQ_MODEL=llama-3.3-70b-versatile

# ── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED. Base64 secret of at least 32 bytes. Generate one with:
#   openssl rand -base64 48
# Dev-only default below decodes to "nutricook-docker-dev-only-secret-CHANGE-ME-0001". Replace it outside local Docker.
JWT_SECRET=bnV0cmljb29rLWRvY2tlci1kZXYtb25seS1zZWNyZXQtQ0hBTkdFLU1FLTAwMDE=
JWT_EXPIRATION_MS=86400000

# Browser origins allowed to call the API (comma-separated). In prod: your frontend URL.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# Demo admin for local Docker only (the prod profile never creates one). Leave the password
# empty to create no admin. Never reuse these values anywhere else.
DEMO_ADMIN_EMAIL=admin@nutricook.local
DEMO_ADMIN_PASSWORD=

# OpenStreetMap's Overpass API (nearby places) asks for an identifying user agent with a contact
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter
OSM_USER_AGENT=NutriCook diet assistant

# ── Database ─────────────────────────────────────────────────────────────────
# The defaults match the Compose "db" service. For prod, point at Neon/Supabase, e.g.
#   DATABASE_URL=jdbc:postgresql://<host>:5432/<db>?sslmode=require
DATABASE_URL=jdbc:postgresql://db:5432/nutricook
DATABASE_USERNAME=nutricook
DATABASE_PASSWORD=nutricook

# Used by the Compose "db" container to initialize PostgreSQL (keep in sync with the above)
POSTGRES_DB=nutricook
POSTGRES_USER=nutricook
POSTGRES_PASSWORD=nutricook
