# ── Local run scripts (contain machine paths & secrets) ──────────────────────
backend/run.bat

# ── Secrets (never commit) ──────────────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
backend/.env.production
frontend/.env
frontend/.env.production

# ── Java / Maven ─────────────────────────────────────────────────────────────
target/
*.class
*.jar
*.war
*.ear
*.nar
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ── LaTeX report build artifacts ────────────────────────────────────────────
docs/*.aux
docs/*.lof
docs/*.lot
docs/*.out
docs/*.toc
docs/*.synctex.gz
docs/compile_*.txt

# ── Spring Boot ──────────────────────────────────────────────────────────────
backend/src/main/resources/application-local.yml
backend/data/

# ── Node / npm ───────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
frontend/dist/
frontend/build/

# ── Python (legacy reference code, root-anchored so frontend/src/lib etc. are not ignored) ──
/venv/
/env/
__pycache__/
*.py[cod]
*$py.class
/build/
/dist/
/lib/
/lib64/
/var/
*.egg-info/

# ── IDE ───────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*.iml

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Project data ─────────────────────────────────────────────────────────────
data/*.csv
data/*.json
!data/sample_data.json
models/*.pkl
logs/
*.log
